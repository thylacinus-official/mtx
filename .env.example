# ==============================================================================
# REQUIRED VARIABLES (Must be specified before launching)
# ==============================================================================

# External public IPv4 address of your server for WebRTC connections (LiveKit)
LIVEKIT_RTC__NODE_IP=192.0.2.1

# Base primary domain (used as fallback for all services)
MTX_DOMAIN=example.com

# LiveKit secret key (must match between livekit and livekit-jwt!)
# Generate in console: openssl rand -hex 32
MTX_LIVEKIT_SECRET=

# Registration token for new users on the Matrix server (Tuwunel)
# Generate in console: openssl rand -hex 16
TUWUNEL_REGISTRATION_TOKEN=


# ==============================================================================
# OPTIONAL VARIABLES (Uncomment to override default values)
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker image versions
# ------------------------------------------------------------------------------
# MTX_CADDY_VERSION=2.11.4
# MTX_ELEMENT_VERSION=1.12.27
# MTX_LIVEKIT_JWT_SERVICE_VERSION=0.7.0
# MTX_LIVEKIT_VERSION=1.13.6
# MTX_TUWUNEL_VERSION=1.9.0

# ------------------------------------------------------------------------------
# Service domains (defaults to MTX_DOMAIN)
# ------------------------------------------------------------------------------
# MTX_ELEMENT_DOMAIN=example.com
# MTX_LIVEKIT_DOMAIN=example.com
# MTX_TUWUNEL_DOMAIN=example.com
# MTX_TUWUNEL_SERVER_NAME=example.com

# ------------------------------------------------------------------------------
# Internal and external ports
# ------------------------------------------------------------------------------
# MTX_ELEMENT_PORT=80
# MTX_FEDERATION_PORT=8448
# MTX_LIVEKIT_JWT_PORT=8080
# MTX_LIVEKIT_PORT=7880
# MTX_TUWUNEL_PORT=8008

# ------------------------------------------------------------------------------
# LiveKit API Key identifier (defaults to devkey)
# ------------------------------------------------------------------------------
# MTX_LIVEKIT_KEY=devkey